<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <FrameLayout android:id="@+id/banner_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:background="?attr/colorSurface" />
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_width="match_parent"
    android:background="?attr/colorPrimary"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@drawable/custom_app_bar_background">

    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/collapsing_toolbar"
        android:layout_width="match_parent"
        app:contentScrim="?attr/colorPrimary"
        android:layout_height="wrap_content"
        app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
        android:padding="0dp"
        app:titleEnabled="false"
        app:expandedTitleTextAppearance="@style/expandedBarTextStyle">

        <LinearLayout
            android:id="@+id/ll_buy_item_cont_002"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Fecha -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title008"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:text="@string/title_request_date"
                    android:paddingRight="10dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textAlignment="textEnd"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_fecha_solicitud"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21/02/2026"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_toRightOf="@id/tv_buy_item_title008"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Capital -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title006"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:text="@string/title_loan_amount"
                    android:textColor="?attr/colorOnPrimary"
                    android:paddingRight="10dp"
                    android:textAlignment="textEnd"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_capital"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 10,000.00"
                    android:layout_toRightOf="@id/tv_buy_item_title006"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Interés -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title004"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:text="@string/title_total_interest"
                    android:paddingRight="10dp"
                    android:textAlignment="textEnd"
                    android:textColor="?attr/colorOnPrimary"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_interes_total"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 899.56"
                    android:layout_toRightOf="@id/tv_buy_item_title004"
                    android:layout_centerVertical="true"
                    android:textColor="?attr/colorOnPrimary"/>
            </RelativeLayout>

            <!-- Seguros -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title001"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:paddingRight="10dp"
                    android:text="@string/title_total_insurance"
                    android:textAlignment="textEnd"
                    android:textColor="?attr/colorOnPrimary"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_seguros_total"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_buy_item_title001"
                    android:text="S/ 89.56"
                    android:textColor="?attr/colorOnPrimary"/>
            </RelativeLayout>

            <!-- Tasa -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title003"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:text="@string/title_interest_rate"
                    android:textAlignment="textEnd"
                    android:paddingRight="10dp"
                    android:textColor="?attr/colorOnPrimary"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_tasa"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_buy_item_title003"
                    android:text="12.000000 %"
                    android:textColor="?attr/colorOnPrimary"/>
            </RelativeLayout>

            <!-- Cuota -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_buy_item_title005"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:paddingRight="10dp"
                    android:text="@string/title_installment"
                    android:textAlignment="textEnd"
                    android:textColor="?attr/colorOnPrimary"/>

                <TextView
                    android:id="@+id/tv_simular_prestamo_cuota_total"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_toRightOf="@id/tv_buy_item_title005"
                    android:text="S/ 984.56"
                    android:layout_centerVertical="true"
                    android:textColor="?attr/colorOnPrimary"/>
            </RelativeLayout>

            <!-- Tipo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_buy_item_title007"
                    style="@style/TextViewConfirmTitleStyle"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/title_type"
                    android:textAlignment="textEnd"
                    android:paddingRight="10dp"
                    android:layout_alignParentLeft="true"/>

                <TextView
                    android:id="@+id/tv_buy_item_type_title"
                    style="@style/TextViewConfirmValStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_toRightOf="@id/tv_buy_item_title007"
                    android:text="@string/title_purchase"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"/>

    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_buy_item"
        android:layout_width= "match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/backgroundApp"
        android:background="@drawable/container_radius"
        android:elevation="1dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        >
        <com.mocii.simuladorprestamos.common.widget.CustomSwipeRefreshLayout
            android:id="@+id/srl_fragment_item_buy_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <!--android:layout_below="@+id/ll_buy_item_cont_002"-->

                <com.mocii.simuladorprestamos.common.widget.AutofitRecyclerView
                    android:id="@+id/rv_fragment_item_buy_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingLeft="25dp"
                    android:paddingTop="40dp"
                    android:paddingRight="25dp"
                    android:paddingBottom="@dimen/margin_huge"
                    tools:listitem="@layout/row_item_installment" />

                <ProgressBar
                    android:id="@+id/pb_fragment_item_buy_list"
                    android:layout_width="@dimen/small_progress_bar_size"
                    android:layout_height="@dimen/small_progress_bar_size"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="@dimen/margin_semi_medium"
                    android:visibility="gone"/>
            </RelativeLayout>

        </com.mocii.simuladorprestamos.common.widget.CustomSwipeRefreshLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/ll_buy_item_actions_center"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        app:layout_anchor="@id/app_bar_layout"
        android:elevation="1dp"
        android:orientation="horizontal"
        android:layout_centerVertical="true"
        app:layout_anchorGravity="bottom|center_horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_simular_back_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:fabCustomSize="50dp"
            app:maxImageSize="15dp"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"
            app:srcCompat="@drawable/ic_arrow_left2"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_simular_share_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:fabCustomSize="60dp"
            app:maxImageSize="15dp"
            app:srcCompat="@drawable/ic_share2"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_simular_download_button"
            android:layout_width="60dp"
            android:layout_height="50dp"
            app:fabCustomSize="50dp"
            android:layout_marginLeft="10dp"
            app:maxImageSize="16dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/download3"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_item_buy_share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_anchorGravity="bottom|left"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="180dp"
            app:fabCustomSize="50dp"
            app:maxImageSize="16dp"
            android:layout_gravity="center"
            android:elevation="16dp"
            android:visibility="gone"
            app:srcCompat="@android:drawable/ic_menu_share"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_buy_item_select_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_anchor="@id/cl_buy_item"
        app:layout_anchorGravity="bottom|left"
        android:paddingVertical="15dp"
        android:paddingHorizontal="35dp"
        android:textSize="16sp"
        android:layout_marginBottom="?attr/actionBarSize"
        android:elevation="16dp"
        android:background="@drawable/container_radius_right"
        android:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        android:text="S/ 0.00"/>
    <RelativeLayout
        android:id="@+id/rl_pb_buy_items"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        >
        <ProgressBar
            android:layout_width="@dimen/small_progress_bar_size"
            android:layout_height="@dimen/small_progress_bar_size"
            android:layout_alignParentBottom="true"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
