                </LinearLayout>

                <!-- Opción 11 -->
                <RadioButton
                    android:id="@+id/rb_setting_color_11"
                    style="@style/ColorItemStyle" />
                <LinearLayout
                    style="@style/ColorItemsContainerStyle">
                    <TextView
                        style="@style/ColorItemSquareStyle"
                        android:background="@color/color1101" />
                    <TextView
