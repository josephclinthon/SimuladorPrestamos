                        android:background = "@color/color0302" />
                    <TextView
                        style="@style/ColorItemSquareStyle"
                        android:background = "@color/color0303" />
                    <TextView
                        style="@style/ColorItemSquareStyle"
                        android:background = "@color/color0304" />
                </LinearLayout>

                <!-- Opción 4 -->
