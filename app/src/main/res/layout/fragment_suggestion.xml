<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sugerencias anónimas" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" android:textSize="16sp"
            android:text="Cuéntanos cómo podemos mejorar la app. No necesitas iniciar sesión ni indicar tu nombre o correo. Evita incluir datos personales en el mensaje. Las sugerencias no son públicas y no tendrán una respuesta individual." />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/suggestion_input" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Tu sugerencia" app:counterEnabled="true" app:counterMaxLength="2000">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/suggestion_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="top" android:minLines="6" android:maxLength="2000"
                android:inputType="textCapSentences|textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/send_suggestion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Enviar sugerencia" />
        <ProgressBar android:id="@+id/suggestion_progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/suggestion_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:layout_marginTop="12dp" android:textSize="16sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
